# MediRelay Backend — Environment Variables Template
# Copy this file to .env and configure for your deployment.
# .env is gitignored and must NEVER be committed.

# --- Required in Production (fail-fast if missing when DJANGO_DEBUG=False) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Do NOT reuse any development keys.
DJANGO_SECRET_KEY=

# --- Core Settings ---
# Set to 'False' in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session lifetime in seconds (default 86400 = 24 hours)
DJANGO_SESSION_COOKIE_AGE=86400

# --- Cache Backend ---
# In production with multiple WSGI workers, configure a shared cache (e.g. Redis)
# so rate-limiting throttle state is synchronized across all workers:
# CACHE_URL=redis://127.0.0.1:6379/1
