# MediRelay Backend — Environment Variables Template
# Copy this file to .env and configure for your deployment.
# .env is gitignored and must NEVER be committed.
#
# NOTE FOR LOCAL DEVELOPMENT:
# When DJANGO_DEBUG=True (the default), you do NOT need to set any environment
# variables to run the app locally. Safe developer defaults will be used.
# To start locally:
#   cd backend
#   python manage.py migrate
#   python manage.py seed_admin --email admin@example.com --password AdminPassword123!
#   python manage.py runserver

# --- Required in Production (fail-fast if missing when DJANGO_DEBUG=False) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Do NOT reuse any development keys.
DJANGO_SECRET_KEY=

# --- Core Settings ---
# Set to 'False' in production
DJANGO_DEBUG=True

# --- Database ---
# Unset = local SQLite (development). Set to a PostgreSQL URL for deployment,
# e.g. Neon: postgresql://user:pass@host/dbname?sslmode=require
# DATABASE_URL=

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session lifetime in seconds (default 86400 = 24 hours)
DJANGO_SESSION_COOKIE_AGE=86400

# Number of reverse proxies (e.g., 1 for Next.js / Nginx reverse proxy)
DJANGO_NUM_PROXIES=1

# Enable Django Admin interface (False by default in production; enabled in dev when DEBUG=True)
DJANGO_ENABLE_ADMIN=False

# --- Cache Backend ---
# In development, Django uses in-memory cache (LocMemCache).
# In production with multiple WSGI workers (Gunicorn/uWSGI), configure a shared
# Redis cache so rate-limiting throttles are synchronized across workers:
# DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# DJANGO_CACHE_LOCATION=redis://127.0.0.1:6379/1
